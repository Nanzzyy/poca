# Database
DATABASE_URL=postgresql+asyncpg://tourism:tourism@localhost:5433/tourism
DATABASE_URL_SYNC=postgresql://tourism:tourism@localhost:5433/tourism

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Optional separate secret for refresh tokens (falls back to JWT_SECRET if empty)
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
# httpOnly cookie auth
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
COOKIE_SECURE=true   # false in local dev (no HTTPS)
COOKIE_DOMAIN=       # optional, e.g. .yourdomain.com

# AI Provider (LiteLLM)
AI_PROVIDER=gemini
AI_MODEL=gemini/gemini-2.0-flash
AI_API_KEY=

# App
APP_NAME=Poca - AI Tourism Companion
DEBUG=false
API_PREFIX=/api/v1
# Comma-separated list of allowed origins — NEVER use "*".
CORS_ORIGINS=https://poca.yourdomain.com,http://localhost:3010
